{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.smaniches/semantic-scholar-mcp",
  "title": "Semantic Scholar MCP Server",
  "version": "1.5.5",
  "description": "MCP server for the Semantic Scholar API: search 200M+ papers, citations, authors, recommendations.",
  "homepage": "https://github.com/smaniches/semantic-scholar-mcp",
  "license": "MIT",
  "author": {
    "name": "Santiago Maniches",
    "url": "https://orcid.org/0009-0005-6480-1987"
  },
  "repository": {
    "url": "https://github.com/smaniches/semantic-scholar-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "s2-mcp-server",
      "version": "1.5.5",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SEMANTIC_SCHOLAR_API_KEY",
          "description": "Semantic Scholar API key for higher rate limits (free at semanticscholar.org/product/api)",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ],
  "keywords": [
    "academic-research",
    "papers",
    "citations",
    "semantic-scholar",
    "research-tools",
    "science",
    "literature-review"
  ]
}
