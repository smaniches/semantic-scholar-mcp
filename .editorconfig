# https://editorconfig.org
# Cross-editor consistency. ruff format is the source of truth for Python.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false  # markdown line breaks use trailing whitespace

[Makefile]
indent_style = tab
